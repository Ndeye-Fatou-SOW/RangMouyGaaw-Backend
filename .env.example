# =========================================================
# TRANSPORT SERVICE — MODÈLE DE CONFIGURATION
# ---------------------------------------------------------
# Copiez ce fichier en « .env » et renseignez vos valeurs.
# Le vrai .env ne doit JAMAIS être versionné (voir .gitignore).
# =========================================================

# ---------- Base de données ----------
DB_URL=jdbc:postgresql://localhost:5433/transport_db
DB_USERNAME=transport_senegal
DB_PASSWORD=votre_mot_de_passe

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=transport-service

# ---------- GPS ----------
GPS_CACHE_TTL_SECONDS=1800
GPS_SIMULATION_ENABLED=true

# ---------- Sécurité JWT ----------
# OBLIGATOIRE : l'application refuse de démarrer sans cette valeur.
# Au moins 32 caractères. Générer une clé :
#   openssl rand -base64 48
JWT_SECRET=remplacez_par_une_cle_aleatoire_de_32_caracteres_minimum
JWT_EXPIRATION_MS=86400000

# ---------- PayTech ----------
# Clés disponibles dans votre tableau de bord PayTech.
PAYTECH_API_KEY=votre_cle_paytech
PAYTECH_API_SECRET=votre_secret_paytech
PAYTECH_IPN_URL=https://votre-domaine/api/v1/transport/tickets/ipn
PAYTECH_SUCCESS_URL=https://votre-domaine/citoyen/ticket/success
PAYTECH_CANCEL_URL=https://votre-domaine/citoyen/ticket/cancel

# ---------- Google Gemini (assistant Dama dem) ----------
GEMINI_API_KEY=votre_cle_gemini
